FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npx tsc

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production MCP_TRANSPORT=http HOST=0.0.0.0 PORT=8080
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --ignore-scripts
COPY --from=build /app/dist ./dist
COPY data ./data
<% if (it.docs && it.docs.contentMode !== "embedded") { %>
# The documentation license does not allow redistribution: it is downloaded while building this image.
# Keep the image in a private registry.
ENV MAKE_MCP_CACHE_DIR=/app/.cache
RUN npx -y <%= it.generator %> refresh . && chown -R node /app/.cache
<% } %>
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
