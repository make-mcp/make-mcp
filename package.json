{
  "name": "make-mcp-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp-server",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p packages/core/templates/ts/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "MAKE_MCP_E2E=1 vitest run e2e",
    "set-version": "node scripts/set-version.mjs",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@types/turndown": "5.0.6",
    "eslint": "10.13.0",
    "minisearch": "7.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
